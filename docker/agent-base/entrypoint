#!/bin/sh
# Entry point of the agent-base image. Loads the home-manager session variables,
# adds an optional corporate CA and runs the given command.
set -eu

hm_vars="$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
if [ -r "$hm_vars" ]; then
  set +u
  # shellcheck source=/dev/null # generated by home-manager, only exists in the image
  . "$hm_vars"
  set -u
fi

ca="${AGENT_CA_FILE:-/run/secrets/ca}"
if [ -r "$ca" ]; then
  bundle="${TMPDIR:-/tmp}/agent-base-ca-bundle.$(id -u).crt"
  cat /nix/var/nix/profiles/default/etc/ssl/certs/ca-bundle.crt "$ca" >"$bundle"
  export NIX_SSL_CERT_FILE="$bundle" SSL_CERT_FILE="$bundle" GIT_SSL_CAINFO="$bundle" NODE_EXTRA_CA_CERTS="$ca"
fi

exec "$@"
